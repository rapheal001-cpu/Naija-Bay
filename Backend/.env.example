# NaijaBay backend — development environment (copy to `.env`).
# Safe to commit; real secrets never belong in this file.
# Every backend variable is listed. Empty = optional/unset.

# Runtime mode: "development" or "production" (drives DEBUG guard rails,
# secure cookies and HTTPS enforcement).
ENVIRONMENT=development

# Generate a new development secret: see README "Getting started".
SECRET_KEY=CHANGE_ME_GENERATE_A_NEW_DEVELOPMENT_SECRET
DEBUG=True

# Django hosts (comma-separated).
ALLOWED_HOSTS=127.0.0.1,localhost
# CSRF + CORS origins (frontend origins).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SITE_ID=1
TIME_ZONE=Africa/Lagos
LANGUAGE_CODE=en-us

# Optional. Leave empty to use the local SQLite file (db.sqlite3).
# PostgreSQL example: postgres://user:password@host:5432/naijabay
DATABASE_URL=

JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=1

DEFAULT_FROM_EMAIL=noreply@naijabay.local

# Storage backend: local (default in development), cloudinary or s3.
MEDIA_STORAGE_BACKEND=local

# Cloudinary (direct browser uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# AWS S3 / R2-compatible (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# SMTP (production; development uses the console backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Paystack. Leave PAYSTACK_SECRET_KEY empty in development for the
# built-in simulated test checkout.
PAYSTACK_SECRET_KEY=

FRONTEND_URL=http://localhost:5173
DELIVERY_FEE=0

# Redis (cache + Channels layer). Empty = in-memory fallbacks.
REDIS_URL=
