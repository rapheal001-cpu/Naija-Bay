# Naija-Bay PRODUCTION environment (never commit real values)
ENVIRONMENT=production
SECRET_KEY=change-me-generate-a-strong-secret
DEBUG=False
ALLOWED_HOSTS=api.naijabay.com,naijabay.com,www.naijabay.com
CSRF_TRUSTED_ORIGINS=https://naijabay.com,https://www.naijabay.com
CORS_ALLOWED_ORIGINS=https://naijabay.com,https://www.naijabay.com
SITE_ID=1
TIME_ZONE=Africa/Lagos
LANGUAGE_CODE=en-us

# Production database (PostgreSQL recommended)
DATABASE_URL=postgres://user:password@host:5432/naijabay

JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=1
DEFAULT_FROM_EMAIL=noreply@naijabay.com

# --- Payments (Paystack) ---
# PAYSTACK_SECRET_KEY=sk_live_...
FRONTEND_URL=https://naijabay.com
DELIVERY_FEE=0

# --- Email (production SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Media storage ---
# production choice: cloudinary | s3
MEDIA_STORAGE_BACKEND=cloudinary

# cloudinary mode:
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# s3 mode (uncomment when MEDIA_STORAGE_BACKEND=s3):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=naijabay-media
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=          # empty = AWS; set for Cloudflare R2
# AWS_S3_CUSTOM_DOMAIN=cdn.naijabay.com

# --- Cache / channels ---
REDIS_URL=redis://127.0.0.1:6379/0
