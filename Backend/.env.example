ENVIRONMENT=development
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SITE_ID=1
TIME_ZONE=Africa/Lagos
LANGUAGE_CODE=en-us
# Leave empty to use the local SQLite file (db.sqlite3); set a URL for PostgreSQL
DATABASE_URL=
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=1
DEFAULT_FROM_EMAIL=noreply@naijabay.ng

# --- Payments (Paystack) ---
# Use your Paystack TEST secret key (sk_test_...) from https://dashboard.paystack.com/#/settings/developers
# Leave empty in development (DEBUG=True) to use the built-in simulated checkout (nothing is charged).
# Required in production. Never commit the real value and never put it in the React app.
PAYSTACK_SECRET_KEY=
# Where Paystack sends the buyer back after paying (the React app)
FRONTEND_URL=http://localhost:5173
# Flat delivery fee added once per order, in naira (0 = free delivery)
DELIVERY_FEE=0

# Production only
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# CLOUD_NAME=
# CLOUD_API_KEY=
# CLOUD_API_SECRET=

# --- Media storage (SkillStream-style switch) ---
# development: local | cloudinary    production: s3 | cloudinary
MEDIA_STORAGE_BACKEND=cloudinary
# S3 mode (production):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=          # empty = AWS; set for Cloudflare R2 / S3-compatible
# AWS_S3_CUSTOM_DOMAIN=         # optional CDN domain

# --- Cache ---
# development: locmem (default)   production: redis
REDIS_URL=redis://127.0.0.1:6379/0
