# NaijaBay backend — EXAMPLE (safe to commit; fill real values in .env).
# Copy to `.env` for local development. Never commit real secrets.
# Process environment variables always win over these files.

# --- Runtime mode ------------------------------------------------------------
# development loads .env; production loads .env.production (only when the
# process environment sets ENVIRONMENT=production).
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=CHANGE_ME_GENERATE_A_NEW_DEVELOPMENT_SECRET

# --- Hosts / origins ---------------------------------------------------------
# Comma-separated. ALLOWED_HOSTS accepts hostnames or full URLs.
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SITE_ID=1
TIME_ZONE=Africa/Lagos
LANGUAGE_CODE=en-us

# --- Database ----------------------------------------------------------------
# Empty = local SQLite (db.sqlite3). PostgreSQL URL in production.
DATABASE_URL=

# --- Auth cookies ------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME=15        # minutes
JWT_REFRESH_TOKEN_LIFETIME=1        # days

# --- Email -------------------------------------------------------------------
# Development uses the console backend; SMTP is used only in production when
# EMAIL_HOST, EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are all set.
DEFAULT_FROM_EMAIL=noreply@naijabay.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Media storage -----------------------------------------------------------
# development: local | cloudinary     production/staging: s3 | cloudinary
MEDIA_STORAGE_BACKEND=local

# Cloudinary (direct browser uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
# Optional signed preset so Cloudinary enforces real size limits on direct uploads
CLOUDINARY_UPLOAD_PRESET=

# AWS S3 / Cloudflare R2-compatible (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# --- Payments (Paystack) -----------------------------------------------------
# Empty in development = simulated test checkout. Required (sk_live_...) in prod.
PAYSTACK_SECRET_KEY=
FRONTEND_URL=http://localhost:5173
DELIVERY_FEE=0                       # flat fee per order, in naira

# --- Cache / WebSockets ------------------------------------------------------
# Empty/omitted = in-memory fallbacks in development. Required in production.
REDIS_URL=redis://127.0.0.1:6379/0
